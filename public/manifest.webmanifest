{
  "id": "/",
  "name": "AmeboGist NG",
  "short_name": "AmeboGist",
  "description": "Nigeria's #1 Pidgin English platform — hot gist, breaking news, AI & Tech, Politics, Entertainment.",
  "categories": ["news", "entertainment", "social"],
  "lang": "en-NG",
  "dir": "ltr",

  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui", "browser"],
  "orientation": "portrait-primary",

  "theme_color": "#065F46",
  "background_color": "#FFFBEB",

  "icons": [
